{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-Bedrock Detection Benchmark Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "expectationId",
    "resultClass",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "expectationId": {
      "type": "string",
      "minLength": 1
    },
    "evaluationScope": {
      "enum": ["reduced-fixture", "full-map-claim-review"]
    },
    "fullMapReview": {
      "type": "object",
      "required": ["frozenObservationFile", "frozenExpectationFile", "reviewedBy", "reviewedAt", "decisions"],
      "properties": {
        "frozenObservationFile": { "type": "string", "minLength": 1 },
        "frozenExpectationFile": { "type": "string", "minLength": 1 },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "blindDeclared": { "type": "boolean" },
        "outputFrozenBeforeReveal": { "type": "boolean" },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claimId", "observedClass", "reason", "observedEvidenceIds"],
            "properties": {
              "claimId": { "type": "string", "minLength": 1 },
              "observedClass": { "enum": ["supported", "rejected", "unknown"] },
              "reason": { "type": "string", "minLength": 10 },
              "observedEvidenceIds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "allOf": [{
              "if": {
                "properties": {
                  "observedClass": { "enum": ["supported", "rejected"] }
                },
                "required": ["observedClass"]
              },
              "then": {
                "properties": {
                  "observedEvidenceIds": { "minItems": 1 }
                }
              }
            }],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "resultClass": {
      "enum": [
        "pass",
        "false-negative",
        "false-positive",
        "semantic-mismatch",
        "evidence-insufficient",
        "runtime-proof-required",
        "fixture-invalid"
      ]
    },
    "metrics": {
      "type": "object",
      "required": [
        "tp",
        "tn",
        "fp",
        "fn",
        "unknown"
      ],
      "properties": {
        "tp": {
          "type": "integer",
          "minimum": 0
        },
        "tn": {
          "type": "integer",
          "minimum": 0
        },
        "fp": {
          "type": "integer",
          "minimum": 0
        },
        "fn": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "precision": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "specificity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "falsePositiveRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "auditQuality": {
      "type": "object",
      "required": [
        "proven",
        "needValidation",
        "runtimeResidue",
        "honestyStatus"
      ],
      "properties": {
        "proven": {
          "type": "integer",
          "minimum": 0
        },
        "needValidation": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeResidue": {
          "type": "integer",
          "minimum": 0
        },
        "totalVisibleFindings": {
          "type": "integer",
          "minimum": 0
        },
        "provenRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "needValidationRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "runtimeResidueRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "honestyStatus": {
          "enum": [
            "PASS",
            "VIOLATION"
          ]
        },
        "validationTestCount": {
          "type": "integer",
          "minimum": 0
        },
        "fullMapReplica": {
          "type": "object",
          "properties": {
            "equivalent": {
              "type": "integer",
              "minimum": 0
            },
            "incompleteProof": {
              "type": "integer",
              "minimum": 0
            },
            "divergenceRequiresClassification": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
