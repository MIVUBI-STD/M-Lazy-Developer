{
  "schemaVersion": 1,
  "package": "Lazy-Developer Toolchain",
  "target": {
    "developerOs": [
      "Windows 10 x64",
      "Windows 11 x64",
      "Linux x64 (ChatGPT tool execution)"
    ],
    "runtimeOs": [
      "Windows 10 x64",
      "Windows 11 x64",
      "Linux x64"
    ],
    "architecture": "x86_64"
  },
  "policy": {
    "nodeMajorPinned": true,
    "pythonMandatory": false,
    "rustMandatory": false,
    "globalBuildToolsRequired": false,
    "endUserToolchainRequired": false,
    "nodeVersionPinned": true,
    "npmVersionPinned": true,
    "lockfileRequired": true
  },
  "node": {
    "major": 22,
    "channel": "LTS",
    "scope": [
      "developer-build",
      "cli-runtime"
    ],
    "pinPolicy": "Node 22.16 ChatGPT-compatible baseline; package engines also permit Node 24",
    "version": "22.16.0"
  },
  "npm": {
    "source": "bundled-with-node",
    "lockfile": "package-lock.json",
    "scope": [
      "developer-build"
    ],
    "version": "10.9.2",
    "pinPolicy": "npm 10.9.2 available in ChatGPT; lockfile v3 retained",
    "installMode": "npm ci",
    "installScripts": "explicit allowlist in package.json#allowScripts"
  },
  "typescript": {
    "source": "package-lock.json",
    "strict": true
  },
  "powershell": {
    "minimumMajor": 7,
    "scope": [
      "windows-developer-routing"
    ]
  }
}
