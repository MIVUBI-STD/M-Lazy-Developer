{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M-Bedrock Detection Benchmark Expectation",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "lane",
    "artifact",
    "target",
    "expected",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "enum": [
        "calibration",
        "acceptance",
        "regression"
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "label",
        "sha256"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "mapVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "edition",
        "minecraftVersion"
      ],
      "properties": {
        "edition": {
          "enum": [
            "bedrock",
            "education"
          ]
        },
        "minecraftVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "anyOf": [
        { "required": ["disposition"] },
        { "required": ["claims"] }
      ],
      "properties": {
        "disposition": {
          "enum": [
            "defect",
            "designed-behavior",
            "ambiguous-intent",
            "insufficient-evidence",
            "runtime-proof-required"
          ]
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "description": "Independently approved source-grounded claims for generic full-map semantic review, not production detector instructions.",
          "items": {
            "type": "object",
            "required": ["id", "subject", "expectedClass", "sourceRefs", "proofCeiling"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "subject": { "type": "string", "minLength": 1 },
              "expectedClass": { "enum": ["supported", "rejected", "unknown"] },
              "sourceRefs": {
                "type": "array", "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "proofCeiling": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "findingKey": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor"
          ]
        },
        "proofCeiling": {
          "type": "string",
          "minLength": 1
        },
        "issueType": {
          "enum": [
            "BUG",
            "DESIGN_MISMATCH"
          ]
        },
        "publicStatus": {
          "enum": [
            "PROVEN",
            "NEED_VALIDATION"
          ]
        },
        "validationAllowed": {
          "type": "boolean",
          "description": "True only when the frozen expectation explicitly permits NEED_VALIDATION because the deciding proof is irreducibly unavailable at the configured evidence ceiling."
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "frozenBeforeRun",
        "source"
      ],
      "properties": {
        "frozenBeforeRun": {
          "const": true
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
