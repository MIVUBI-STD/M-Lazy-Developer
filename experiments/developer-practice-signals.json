  "patterns": [
    {
      "id": "developer.hint.coordinate.position-vs-block",
      "sourceId": "src.bedrock-coordinates",
      "heading": "Spawn point versus block coordinate",
      "kind": "IMPLEMENTATION_PATTERN",
      "status": "SOURCE_REVIEWED",
      "domains": [
        "spatial",
        "spawn",
        "geometry"
      ],
      "sourceSignals": [
        "teleport",
        "spawn",
        "setblock",
        "floor",
        "0.5"
      ],
      "question": "Does a coordinate represent an entity/player position or a block/region coordinate?",
      "candidateRelations": [
        "authored coordinate → spatial position type",
        "spawn/teleport → target region"
      ],
      "negativeControl": "Fractional authored coordinates can already be exact intended positions; block operations do not require centering",
      "versionApplicability": "NOT_INDEPENDENTLY_VERIFIED",
      "prohibits": "Never adjust map coordinates or claim a spatial bug based on an unconditional +0.5 rule"
    },
    {
      "id": "developer.hint.entity.damage-owner",
      "sourceId": "src.bedrock-entity-creation",
      "heading": "Damage: JSON or script?",
      "kind": "DESIGN_INTERPRETATION_HINT",
      "status": "SOURCE_REVIEWED",
      "domains": [
        "entity",
        "combat",
        "arena",
        "policy"
      ],
      "sourceSignals": [
        "minecraft:damage_sensor",
        "minecraft:component_groups",
        "world.beforeEvents.entityHurt",
        "allowedDamageCauses"
      ],
      "question": "Is damage controlled by the entity's own JSON state, or by game/arena/team phase conditions in script?",
      "candidateRelations": [
        "entity component or component-group → local damage policy",
        "round/arena/team state guard → conditional damage treatment"
      ],
      "negativeControl": "An entity with a static damage sensor may correctly implement its full behavior without a Script API handler",
      "versionApplicability": "NOT_INDEPENDENTLY_VERIFIED",
      "prohibits": "Do not assume invulnerability, friendly-fire policy or required script handlers from component names alone, or equate authored sensor with live damage prevention"
    },
    {
      "id": "developer.hint.entity.removal-vs-death",
      "sourceId": "src.bedrock-entity-lifecycle",
      "heading": "Removing entities: choose by intent",
      "kind": "DESIGN_INTERPRETATION_HINT",
      "status": "SOURCE_REVIEWED",
      "domains": [
        "entity",
        "combat",
        "cleanup"
      ],
      "sourceSignals": [
        "Entity.kill",
        "Entity.remove",
        "minecraft:instant_despawn",
        "entityDie",
        "entityRemove"
      ],
      "question": "Is entity disappearance part of a combat outcome or a reset/cleanup lifecycle?",
      "candidateRelations": [
        "entity death → possible combat progression",
        "entity remove/despawn → possible cleanup"
      ],
      "negativeControl": "A kill used for intentional combat outcome and a removal used for cleanup can both be valid",
      "versionApplicability": "NOT_INDEPENDENTLY_VERIFIED",
      "prohibits": "Never equate remove/despawn with a win, or require one removal method for all maps"
    },
    {
      "id": "developer.hint.forms.stale-response",
      "sourceId": "src.bedrock-forms",
      "heading": "Form service and force-close rules",
      "kind": "IMPLEMENTATION_PATTERN",
      "status": "SOURCE_REVIEWED",
      "domains": [
        "ui",
        "session",
        "lifecycle"
      ],
      "sourceSignals": [
        "ActionFormData",
        "ModalFormData",
        "MessageFormData",
        "closeAllForms"
      ],
      "question": "Does this map tie a pending form response to the same session/phase that opened it?",
      "candidateRelations": [
        "player interaction → UI response",
        "session/phase guard → allowed state mutation",
        "cancel/close → no mutation"
      ],
      "negativeControl": "A legitimately persistent, non-session-specific form is not automatically stale",
      "versionApplicability": "NOT_INDEPENDENTLY_VERIFIED",
      "prohibits": "Do not classify an unguarded form as a bug without selected-map design and reachable effect evidence"
    },
    {
      "id": "developer.hint.hud.message-owner",
      "sourceId": "src.bedrock-onscreen-display",
      "heading": "Action bar ownership",
      "kind": "DESIGN_INTERPRETATION_HINT",
      "status": "SOURCE_REVIEWED",
      "domains": [
        "ui",
        "client-feedback",
        "lifecycle",
        "round"
      ],
      "sourceSignals": [
        "onScreenDisplay.setActionBar",
        "onScreenDisplay.setTitle",
        "setHudVisibility",
        "title",
        "titleraw"
      ],
      "question": "What gameplay state does the HUD describe, and what happens to time-limited feedback on round transitions, death or lobby return?",
      "candidateRelations": [
        "phase / round state → candidate player-facing HUD text",
        "temporary feedback → possible expiration or replacement",
        "reset → candidate display cleanup"
      ],
      "negativeControl": "A command-driven HUD or multiple independently scoped display owners may be intentional and correct in a particular map",
      "versionApplicability": "NOT_INDEPENDENTLY_VERIFIED",
      "prohibits": "Do not require a single HUD adapter or diagnose a stale HUD from source calls without verifying player-visible output and approved behavior"
    },
    {
      "id": "developer.hint.logging.player-vs-dev",
      "sourceId": "src.bedrock-debug-logging",
      "heading": "Console and logging boundaries",
      "kind": "TEAM_IMPLEMENTATION_POLICY",
      "status": "SOURCE_REVIEWED",
      "domains": [
        "observability",
        "ui",
        "debug"
      ],
      "sourceSignals": [
        "console.warn",
        "console.error",
        "sendMessage",
        "Content Log"
      ],
      "question": "Is the message intended for players or for developer diagnosis, and is it on a material gameplay path?",
      "candidateRelations": [
        "error path → diagnostic signal",
        "player-facing text → feedback"
      ],
      "negativeControl": "Intentional player-facing diagnostic information or admin tools can be part of approved map design",
      "versionApplicability": "NOT_INDEPENDENTLY_VERIFIED",
      "prohibits": "Do not issue a defect merely for nonconformity with this team's preferred logger"
    },
    {
      "id": "developer.hint.persistence.state-ownership",
      "sourceId": "src.bedrock-data-persistence",
      "heading": "Data places and world versus player storage",
      "kind": "DESIGN_INTERPRETATION_HINT",
      "status": "SOURCE_REVIEWED",
      "domains": [
        "state",
        "player",
        "arena",
        "persistence"
      ],
      "sourceSignals": [
        "setDynamicProperty",
        "getDynamicProperty",
        "scoreboard",
        "config.ts"
      ],
      "question": "Which actor/session/arena owns the state, how long does it survive, and where is the reset or recovery?",
      "candidateRelations": [
        "data owner → persistence scope",
        "disconnect/reconnect → possible preserve/reset",
        "state write → later read"
      ],
      "negativeControl": "Scoreboards can legitimately store gameplay state in maps; the author's display-only preference is not universal",
      "versionApplicability": "NOT_INDEPENDENTLY_VERIFIED",
      "prohibits": "Do not mark scoreboard storage or a different persistence strategy as defective merely for differing from this author's preference"
    },
    {
      "id": "developer.hint.profiler.source-hotspots",
      "sourceId": "src.bedrock-debug-profiling",
      "heading": "Profiling",
      "kind": "IMPLEMENTATION_PATTERN",
      "status": "SOURCE_REVIEWED",
      "domains": [
        "performance",
        "scheduler",
        "entities",
        "capacity"
      ],
      "sourceSignals": [
        "getAllPlayers",
        "getEntities",
        "getDynamicProperty",
        "isChunkLoaded",
        "system.runInterval",
        "script profiler"
      ],
      "question": "Which potentially high-frequency source operations have a measured effect on active gameplay, and what phase/concurrency context is relevant?",
      "candidateRelations": [
        "scheduled task → recurring candidate cost",
        "entity query / chunk check → candidate active-phase runtime work",
        "resource lifecycle → potential repeated cleanup"
      ],
      "negativeControl": "High call frequency alone does not prove lag or a performance bug; performance depends on actual target device, concurrency and measured timings",
      "versionApplicability": "NOT_INDEPENDENTLY_VERIFIED",
      "prohibits": "Do not report runtime lag from a static hot-spot signature, copy the author's performance percentages, or assume a 30-player target applies to other maps"
    },
    {
      "id": "developer.hint.sound.feedback-vs-outcome",
      "sourceId": "src.bedrock-sound",
      "heading": "Playing sounds from script",
      "kind": "DESIGN_INTERPRETATION_HINT",
      "status": "SOURCE_REVIEWED",
      "domains": [
        "audio",
        "client-feedback",
        "events",
        "round"
      ],
      "sourceSignals": [
        "playSound",
        "sound_definitions.json",
        "playsound",
        "stopSound",
        "stopAllSounds"
      ],
      "question": "Is the sound event a feedback cue, an ambient loop, or part of an authored gameplay sequence, and which player/group is its intended audience?",
      "candidateRelations": [
        "event or action → attempted audible cue",
        "state/phase change → candidate music/ambience transition",
        "sound selection → audience scope"
      ],
      "negativeControl": "An intentional music or sound cue may not correspond to a terminal win/lose action; no sound is required by default",
      "versionApplicability": "NOT_INDEPENDENTLY_VERIFIED",
      "prohibits": "Do not treat an authored sound reference as delivered audio, a win condition, or evidence that an event succeeded"
    },
